# ──────────────────────────────────────────────────────────
# HealthGuard AI — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   copy .env.example .env
# ──────────────────────────────────────────────────────────

# Database
DATABASE_URL=mongodb://localhost:27017/healthcare_db
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=healthcare_db

# Machine Learning
MODEL_PATH=app/ml/model.joblib

# Application
APP_PORT=8000

# Docker
DOCKER_IMAGE_NAME=healthguard-ai

# ──────────────────────────────────────────────────────────
# GitHub Secrets (do NOT commit real values here)
# ──────────────────────────────────────────────────────────
# DOCKER_USERNAME=your_dockerhub_username
# DOCKER_PASSWORD=your_dockerhub_access_token
# KUBE_CONFIG=base64_encoded_kubeconfig
